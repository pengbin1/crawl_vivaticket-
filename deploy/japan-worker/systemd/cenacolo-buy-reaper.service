[Unit]
Description=Cenacolo buy lease reaper (oneshot)
After=network-online.target

[Service]
Type=oneshot
User=cenacolo
Group=cenacolo
WorkingDirectory=/opt/cenacolo/services/buy
Environment=CENACOLO_HOME=/opt/cenacolo
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cenacolo/services/buy/.venv/bin/python run_worker.py --reap --config /opt/cenacolo/etc/buy.local.yaml
StandardOutput=journal
StandardError=journal

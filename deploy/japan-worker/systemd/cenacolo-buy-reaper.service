[Unit]
Description=Cenacolo buy lease reaper (oneshot)
After=network-online.target

[Service]
Type=oneshot
User=__RUN_USER__
WorkingDirectory=__CENACOLO_HOME__/services/buy
Environment=CENACOLO_HOME=__CENACOLO_HOME__
Environment=PYTHONUNBUFFERED=1
ExecStart=__CENACOLO_HOME__/services/buy/.venv/bin/python run_worker.py --reap --config __CENACOLO_HOME__/etc/buy.local.yaml
StandardOutput=journal
StandardError=journal

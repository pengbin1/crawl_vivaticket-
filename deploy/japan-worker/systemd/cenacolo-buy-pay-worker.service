[Unit]
Description=Cenacolo buy pay worker (pay locked orders within seat-hold window)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__CENACOLO_HOME__/services/buy
Environment=CENACOLO_HOME=__CENACOLO_HOME__
Environment=PYTHONUNBUFFERED=1
ExecStart=__CENACOLO_HOME__/services/buy/.venv/bin/python run_pay_worker.py --config __CENACOLO_HOME__/etc/buy.local.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
